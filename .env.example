# ─────────────────────────────────────────────
# Task Management Dashboard — Environment Config
# Copy this file to .env and fill in real values
# NEVER commit .env with real credentials
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=taskboard
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────
# Full DATABASE_URL (overrides individual Postgres vars inside backend)
DATABASE_URL=postgresql://taskboard:change_me_in_production@db:5432/taskboard

# JWT secret — generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173

# ── External API ──────────────────────────────
# Open-Meteo is free and requires no API key.
# If you switch to a paid provider, add the key here:
# WEATHER_API_KEY=your_key_here

# ── App Settings ─────────────────────────────
APP_ENV=development
DEBUG=true
